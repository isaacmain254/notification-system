# App configuration
SERVICE_NAME="notification-system"
SERVICE_ENVIRONMENT="development"
SERVICE_PORT=5000

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification-system
DB_USER=postgres
DB_PASSWORD=password
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE_TIME=5
DB_MAX_CONN_LIFETIME=30


# RabbitMQ configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=notification
RABBITMQ_PASSWORD=notification-dev-password
RABBITMQ_PREFETCH=10
OUTBOX_BATCH_SIZE=50
